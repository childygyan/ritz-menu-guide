---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/global.css";
---

<BaseLayout
  title="Terms of Service — The Ritz Menu Guide"
  description="Terms of service for The Ritz Menu Guide: informational use, no affiliation, price accuracy disclaimer."
  path="/terms-of-service/"
>
  <article class="max-w-3xl mx-auto px-4 sm:px-6 py-12">
    <h1 class="font-display text-3xl sm:text-4xl font-bold">Terms of Service</h1>
    <p class="mt-2 text-sm text-ink-soft">Last updated: October 2026</p>

    <div class="prose-guide mt-8">
      <h2>Informational use only</h2>
      <p>
        The Ritz Menu Guide is an independent informational website. Content is provided
        "as is" for general information — it is not a booking service and does not sell
        anything.
      </p>
      <h2>No affiliation</h2>
      <p>
        This site is not affiliated with, endorsed by, sponsored by, or connected to
        The Ritz London or any of its owners, operators, or staff. "The Ritz" and related
        names are trademarks of their respective owners, referenced here only to describe
        the subject of our guides.
      </p>
      <h2>Prices and accuracy</h2>
      <p>
        Prices, menus, hours, and policies change. We date our sources and aim for
        accuracy, but we make no guarantee that any figure is current. Always verify
        directly with the hotel before making plans or relying on any number on this site.
        We are not liable for decisions made based on this content.
      </p>
      <h2>Original content</h2>
      <p>
        Text and illustrations on this site are original. Menus are described and
        summarised in our own words; official documents are linked, not reproduced.
      </p>
      <h2>Acceptable use</h2>
      <p>
        Don't scrape, republish, or misrepresent this site's content, and don't use it for
        anything unlawful. We may update these terms at any time by posting a new version
        here.
      </p>
    </div>
  </article>
</BaseLayout>
