---
interface Props {
  title: string;
  description: string;
  path?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  ogImage?: string;
}

const { title, description, path = "/", jsonLd, ogImage = "/images/hero-home.webp" } = Astro.props;
const site = "https://ritz-menu-guide.pages.dev";
const canonical = new URL(path, site).toString();
const ogImageUrl = new URL(ogImage, site).toString();

// Every guide on this site. Add a new { label, href } entry here and it
// appears in the desktop dropdown, the mobile menu, and the footer —
// no other changes needed.
const guides = [
  { label: "The Ritz Restaurant — Menu Guide", href: "/the-ritz-restaurant-menu/" },
  { label: "Afternoon Tea — Guide", href: "/ritz-afternoon-tea/" },
  { label: "Menu Prices — Guide", href: "/ritz-menu-prices/" },
  { label: "Booking Guide", href: "/ritz-booking-guide/" },
];
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Firoz Khan" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="The Ritz Menu Guide" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body class="min-h-screen flex flex-col">
    <header class="border-b border-line bg-cream/95 sticky top-0 z-40">
      <nav class="max-w-5xl mx-auto px-4 sm:px-6 py-4 flex items-center justify-between" aria-label="Primary">
        <a href="/" class="font-display text-xl sm:text-2xl font-bold">
          The Ritz Menu <span class="text-gold-dark">Guide</span>
        </a>
        <div class="hidden md:flex items-center gap-6 text-sm font-medium">
          <a href="/" class="hover:text-gold-dark">Home</a>
          <div class="relative" data-dropdown>
            <button
              type="button"
              data-dropdown-button
              aria-haspopup="true"
              aria-expanded="false"
              aria-controls="guides-menu"
              class="inline-flex items-center gap-1 hover:text-gold-dark cursor-pointer"
            >
              Guides
              <svg data-dropdown-chevron class="w-3.5 h-3.5 transition-transform duration-200" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M4 6l4 4 4-4" />
              </svg>
            </button>
            <div id="guides-menu" data-dropdown-menu hidden class="absolute right-0 mt-2 w-80 rounded-xl border border-line bg-white shadow-lg py-2 text-sm">
              {guides.map((g) => (
                <a href={g.href} class="block px-4 py-2.5 text-ink-soft hover:text-gold-dark hover:bg-cream">
                  {g.label}
                </a>
              ))}
            </div>
          </div>
          <a href="/about/" class="hover:text-gold-dark">About</a>
          <a href="/contact/" class="hover:text-gold-dark">Contact</a>
        </div>
        <a href="/the-ritz-restaurant-menu/" class="md:hidden text-sm font-medium text-gold-dark border border-gold rounded-full px-4 py-1.5">
          Guides
        </a>
      </nav>
      <nav class="md:hidden border-t border-line" aria-label="Mobile navigation" data-dropdown>
        <ul class="max-w-5xl mx-auto px-4 py-2.5 flex gap-5 text-sm text-ink-soft overflow-x-auto whitespace-nowrap">
          <li><a href="/" class="hover:text-gold-dark">Home</a></li>
          <li>
            <button
              type="button"
              data-dropdown-button
              aria-haspopup="true"
              aria-expanded="false"
              aria-controls="guides-menu-mobile"
              class="inline-flex items-center gap-1 hover:text-gold-dark focus-visible:outline-2 focus-visible:outline-gold-dark rounded-sm cursor-pointer"
            >
              Guides
              <svg data-dropdown-chevron class="w-3.5 h-3.5 transition-transform duration-200" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M4 6l4 4 4-4" />
              </svg>
            </button>
          </li>
          <li><a href="/about/" class="hover:text-gold-dark">About</a></li>
          <li><a href="/contact/" class="hover:text-gold-dark">Contact</a></li>
        </ul>
        <div id="guides-menu-mobile" data-dropdown-menu hidden class="border-t border-line bg-white">
          <ul class="max-w-5xl mx-auto px-4 py-2 text-sm" aria-label="Guides">
            {guides.map((g) => (
              <li>
                <a href={g.href} class="block py-2.5 text-ink-soft hover:text-gold-dark border-b border-line/60 last:border-0">
                  {g.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </nav>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="bg-ink text-cream mt-16">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 py-12">
        <div class="grid gap-8 md:grid-cols-3">
          <div>
            <p class="font-display text-xl font-bold">The Ritz Menu <span class="text-gold">Guide</span></p>
            <p class="mt-3 text-sm text-cream/70 leading-relaxed">
              Independent, original guides to dining at The Ritz London: the restaurant's
              menus, afternoon tea, prices, and booking. Prices from official Ritz sources,
              dated — always verify with the hotel before visiting.
            </p>
          </div>
          <div>
            <p class="text-sm font-semibold uppercase tracking-wider text-gold mb-4">Guides</p>
            <ul class="space-y-2 text-sm text-cream/80">
              {guides.map((g) => (
                <li><a href={g.href} class="hover:text-gold transition-colors">{g.label}</a></li>
              ))}
            </ul>
          </div>
          <div>
            <p class="text-sm font-semibold uppercase tracking-wider text-gold mb-4">Site</p>
            <ul class="space-y-2 text-sm text-cream/80">
              <li><a href="/about/" class="hover:text-gold transition-colors">About</a></li>
              <li><a href="/contact/" class="hover:text-gold transition-colors">Contact</a></li>
              <li><a href="/privacy-policy/" class="hover:text-gold transition-colors">Privacy Policy</a></li>
              <li><a href="/terms-of-service/" class="hover:text-gold transition-colors">Terms of Service</a></li>
            </ul>
          </div>
        </div>
        <div class="mt-10 pt-6 border-t border-cream/15 text-xs text-cream/50 flex flex-col sm:flex-row justify-between gap-2">
          <p>© 2026 The Ritz Menu Guide. All content original.</p>
          <p>Not affiliated with The Ritz London.</p>
        </div>
      </div>
    </footer>

    <script>
      // Nav dropdowns (desktop + mobile): click to toggle, Escape closes,
      // outside click closes, focus leaving the button+menu closes it.
      (function () {
        var pairs = [];
        document.querySelectorAll("[data-dropdown-button]").forEach(function (button) {
          var menu = document.getElementById(button.getAttribute("aria-controls") || "");
          if (!menu) return;
          pairs.push({
            button: button,
            menu: menu,
            chevron: button.querySelector("[data-dropdown-chevron]"),
          });
        });

        function setOpen(pair, open) {
          pair.menu.hidden = !open;
          pair.button.setAttribute("aria-expanded", open ? "true" : "false");
          if (pair.chevron) pair.chevron.classList.toggle("rotate-180", open);
        }

        function closeAll() {
          pairs.forEach(function (p) {
            setOpen(p, false);
          });
        }

        pairs.forEach(function (pair) {
          pair.button.addEventListener("click", function (e) {
            e.stopPropagation();
            var willOpen = pair.menu.hidden;
            closeAll();
            setOpen(pair, willOpen);
          });

          function onKey(e) {
            if (e.key === "Escape") {
              setOpen(pair, false);
              pair.button.focus();
            }
          }
          pair.button.addEventListener("keydown", onKey);
          pair.menu.addEventListener("keydown", onKey);

          function onFocusOut(e) {
            var t = e.relatedTarget;
            if (!t || (t !== pair.button && !pair.menu.contains(t))) setOpen(pair, false);
          }
          pair.button.addEventListener("focusout", onFocusOut);
          pair.menu.addEventListener("focusout", onFocusOut);
        });

        document.addEventListener("click", function (e) {
          if (!e.target.closest("[data-dropdown]")) closeAll();
        });

        document.addEventListener("keydown", function (e) {
          if (e.key === "Escape") closeAll();
        });
      })();
    </script>
  </body>
</html>
